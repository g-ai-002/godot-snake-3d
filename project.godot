; Engine configuration file.
; 贪吃蛇 3D —— Godot 4.7.2 / GDScript

config_version=5

[application]

config/name="贪吃蛇 3D"
config/description="基于 Godot 4.7.2 与 GDScript 的 3D 贪吃蛇：多实例蛇身、动态光影、粒子与自由视角。"
config/version="0.1.0"
run/main_scene="res://scenes/main.tscn"
config/features=PackedStringArray("4.7", "Forward Plus")
config/icon="res://icon.svg"
boot_splash/bg_color=Color(0.015, 0.02, 0.04, 1)
boot_splash/show_image=false

[autoload]

SaveData="*res://scripts/save_data.gd"
Sfx="*res://scripts/sfx.gd"

[display]

window/size/viewport_width=1280
window/size/viewport_height=720
window/size/window_width_override=1280
window/size/window_height_override=720
window/stretch/mode="canvas_items"
window/stretch/aspect="expand"

[gui]

theme/default_font_multichannel_signed_distance_field=true

[rendering]

renderer/rendering_method="forward_plus"
renderer/rendering_method.mobile="mobile"
renderer/rendering_method.web="gl_compatibility"
environment/defaults/default_clear_color=Color(0.015, 0.02, 0.04, 1)
anti_aliasing/quality/msaa_3d=2
lights_and_shadows/directional_shadow/soft_shadow_filter_quality=3
